[186.488446, "o", "#"]
[186.592595, "o", " "]
[187.011781, "o", "generate coordinates inside a given bounding box (bbox) and ensure they are on land\r\n"]
[187.01192, "o", ">>> "]
[187.672366, "o", "\r\n"]
[187.672573, "o", ">>> "]
[191.479539, "o", "from services.geo_data_generator import FakeGeoGenerator"]
[191.792717, "o", "\r\n"]
[192.135219, "o", ">>> "]
[194.875749, "o", "from shapely.geometry import box"]
[195.112592, "o", "\r\n"]
[195.112767, "o", ">>> "]
[197.996873, "o", "from pprint import pprint"]
[198.176749, "o", "\r\n"]
[198.17694, "o", ">>> "]
[199.136615, "o", "\r\n"]
[199.136875, "o", ">>> "]
[202.062818, "o", "fake_geo_generator = FakeGeoGenerator(seed=42)"]
[202.280633, "o", "\r\n"]
[202.383101, "o", ">>> "]
[205.872877, "o", "bbox = box(minx=-64.182129, miny=-53.733279, maxx=-54.426270, maxy=-50.047439)"]
[206.272595, "o", "\r\n"]
[206.273313, "o", ">>> "]
[209.654708, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
[210.080742, "o", "\r\n"]
[210.084209, "o", ">>> "]
[210.545343, "o", "\r\n"]
[210.545451, "o", ">>> "]
[213.97225, "o", "pprint(generated_coordinates_inside_bbox)"]
[214.121701, "o", "\r\n"]
