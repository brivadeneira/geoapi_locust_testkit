[126.93476, "o", ">>> "]
[127.629893, "o", "\r\n"]
[127.630099, "o", ">>> "]
[131.21106, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox)"]
