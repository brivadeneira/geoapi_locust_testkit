[214.122445, "o", ">>> "]
[214.424785, "o", "\r\n>>> "]
[220.180036, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
[220.345286, "o", "\r\n"]
[220.348774, "o", ">>> "]
