[115.742028, "o", "\r\n"]
[115.742289, "o", ">>> "]
[118.528179, "o", "from pprint import pprint"]
[118.677621, "o", "\r\n"]
[118.677859, "o", ">>> "]
[121.382916, "o", "fake_geo_generator = FakeGeoGenerator(seed=42)"]
[121.518438, "o", "\r\n"]
[121.624738, "o", ">>> "]
[126.810241, "o", "bbox = box(minx=-64.182129, miny=-53.733279, maxx=-54.426270, maxy=-50.047439)"]
