[7.622202, "o", ">>> "]
[8.959716, "o", "#"]
[9.063789, "o", " "]
[9.483068, "o", "generate coordinates inside a given bounding box (bbox) and ensure they are on land\r\n"]
[9.483258, "o", ">>> "]
[10.143471, "o", "\r\n"]
[10.143651, "o", ">>> "]
[13.95085, "o", "from services.geo_data_generator import FakeGeoGenerator"]
[14.263902, "o", "\r\n"]
[14.606325, "o", ">>> "]
[17.347058, "o", "from shapely.geometry import box"]
[17.583667, "o", "\r\n"]
[17.583976, "o", ">>> "]
[20.468181, "o", "from pprint import pprint"]
[20.647955, "o", "\r\n"]
[20.648142, "o", ">>> "]
[21.607788, "o", "\r\n"]
[21.607963, "o", ">>> "]
[24.534135, "o", "fake_geo_generator = FakeGeoGenerator(seed=42)"]
[24.751855, "o", "\r\n"]
[24.85433, "o", ">>> "]
[28.344201, "o", "bbox = box(minx=-64.182129, miny=-53.733279, maxx=-54.426270, maxy=-50.047439)"]
[28.74373, "o", "\r\n"]
[28.744399, "o", ">>> "]
[32.125848, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
[32.551946, "o", "\r\n"]
[32.555469, "o", ">>> "]
[33.016582, "o", "\r\n"]
[33.016728, "o", ">>> "]
[36.44356, "o", "pprint(generated_coordinates_inside_bbox)"]
[36.592886, "o", "\r\n"]
[36.593328, "o", "{'latitude': -52.03214711422142,\r\n 'longitude': -58.65917431113416,\r\n "]
[36.593517, "o", "'osm_url': 'https://www.openstreetmap.org/?mlat=-52.03214711422142&mlon=-58.65917431113416&zoom=5'}\r\n"]
[36.593708, "o", ">>> "]
[36.896021, "o", "\r\n>>> "]
[42.651256, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
[42.816422, "o", "\r\n"]
[42.819872, "o", ">>> "]
[44.368561, "o", "generated_coordinates_inside_bbox"]
[44.528072, "o", "\r\n"]
