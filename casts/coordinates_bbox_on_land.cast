[44.528477, "o", ">>> "]
[47.736905, "o", "\r\n"]
[47.737115, "o", ">>> "]
[48.640318, "o", "generated_coordinates_inside_bbox"]
[48.78432, "o", " = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
