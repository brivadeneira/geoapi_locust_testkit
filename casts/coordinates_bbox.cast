[87.813283, "o", ">>> "]
[89.1508, "o", "#"]
[89.254902, "o", " "]
[89.674146, "o", "generate coordinates inside a given bounding box (bbox) and ensure they are on land\r\n"]
[89.674301, "o", ">>> "]
[90.33468, "o", "\r\n"]
[90.334881, "o", ">>> "]
[94.141903, "o", "from services.geo_data_generator import FakeGeoGenerator"]
[94.45504, "o", "\r\n"]
[94.797506, "o", ">>> "]
[97.538121, "o", "from shapely.geometry import box"]
[97.77484, "o", "\r\n"]
[97.775062, "o", ">>> "]
[100.659241, "o", "from pprint import pprint"]
[100.839063, "o", "\r\n"]
[100.839242, "o", ">>> "]
[101.798909, "o", "\r\n"]
[101.799116, "o", ">>> "]
[104.725192, "o", "fake_geo_generator = FakeGeoGenerator(seed=42)"]
[104.942951, "o", "\r\n"]
[105.045425, "o", ">>> "]
[108.535252, "o", "bbox = box(minx=-64.182129, miny=-53.733279, maxx=-54.426270, maxy=-50.047439)"]
[108.93484, "o", "\r\n"]
[108.935552, "o", ">>> "]
[112.316968, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
[112.743052, "o", "\r\n"]
[112.74655, "o", ">>> "]
[113.207652, "o", "\r\n"]
[113.207769, "o", ">>> "]
[116.634617, "o", "pprint(generated_coordinates_inside_bbox)"]
[116.784007, "o", "\r\n"]
[116.784437, "o", "{'latitude': -52.03214711422142,\r\n 'longitude': -58.65917431113416,\r\n "]
[116.784617, "o", "'osm_url': 'https://www.openstreetmap.org/?mlat=-52.03214711422142&mlon=-58.65917431113416&zoom=5'}\r\n"]
[116.784781, "o", ">>> "]
[117.087113, "o", "\r\n>>> "]
[122.842347, "o", "generated_coordinates_inside_bbox = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
[123.007588, "o", "\r\n"]
[123.011078, "o", ">>> "]
[124.55966, "o", "generated_coordinates_inside_bbox"]
[124.719167, "o", "\r\n"]
