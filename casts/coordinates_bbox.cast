[124.719575, "o", ">>> "]
[127.928004, "o", "\r\n"]
[127.928269, "o", ">>> "]
[128.831547, "o", "generated_coordinates_inside_bbox"]
[128.975447, "o", " = fake_geo_generator.generate_coordinates(bbox=bbox, on_land=True)"]
